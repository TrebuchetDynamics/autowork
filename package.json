{
  "name": "hermes-toolset",
  "version": "0.2.0",
  "bin": {
    "autowork": "pi-autowork/bin/autowork",
    "tx": "tmux/tx"
  },
  "description": "Hermes Toolset workflows for the Pi coding agent",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/TrebuchetDynamics/hermes-toolset.git"
  },
  "files": [
    "adapters/",
    "skills/",
    "scripts/pi-autowork.sh",
    "scripts/pi_autowork_touches.py",
    "pi-autowork/pi_autowork/",
    "pi-autowork/bin/",
    "pi-autowork/README.md",
    "!**/__pycache__",
    "LICENSE",
    "README.md",
    "docs/cross-host.md",
    "tmux/"
  ],
  "pi": {
    "extensions": [
      "./adapters/pi.mjs"
    ],
    "skills": [
      "./adapters/skills"
    ]
  },
  "engines": {
    "node": ">=22"
  }
}
