}

is_reserved_alias() {
  local a=$1 r
  for r in "${RESERVED_ALIASES[@]}"; do
    [[ "$a" == "$r" ]] && return 0
  done
  return 1
}

validate_alias_list() {
  local keys=$1 context=${2:-alias} part
  local -a parts
  IFS=',' read -ra parts <<< "$keys"
  for part in "${parts[@]}"; do
    [[ -n "$part" ]] || die "$context: empty alias in '$keys' (check for stray commas)"
    [[ "$part" =~ ^[A-Za-z0-9_-]+$ ]] || die "$context: invalid alias '$part'"
    if is_reserved_alias "$part"; then
      die "$context: alias '$part' is reserved (used by a subcommand)"
    fi
  done
}

prompt_alias_list() {
  local target=$1 keys=""
  printf 'Alias for %s: ' "$target" >&2
  IFS= read -r keys || die "add: alias prompt cancelled"
  [[ -n "${keys//[[:space:]]/}" ]] || die "add: alias is required"
  printf '%s\n' "$keys"
}

# expand_vars VALUE VARS_ASSOC_NAME -> stdout
# Substitutes $VAR references using vars defined earlier in the config file.
expand_vars() {
  local val=$1
  local -n _vars=$2
  local result=""
  local rest=$val
  while [[ "$rest" =~ ^([^$]*)\$([A-Z_][A-Z0-9_]*)(.*)$ ]]; do
    local prefix=${BASH_REMATCH[1]}
    local name=${BASH_REMATCH[2]}
    local tail=${BASH_REMATCH[3]}
    result+=$prefix
    if [[ -z "${_vars[$name]+x}" ]]; then
      die "config: undefined variable \$$name (only vars defined earlier in the file may be used)"
    fi
    result+=${_vars[$name]}
    rest=$tail
  done
  result+=$rest
  printf '%s' "$result"
}

expand_tilde() {
  local p=$1
  if [[ "$p" == "~" ]]; then
    printf '%s' "$HOME"
  elif [[ "$p" == "~/"* ]]; then
    printf '%s%s' "$HOME" "${p:1}"
  else
    printf '%s' "$p"
  fi
}

display_path() {
  local p=$1
  local strip_prefix=${TX_DISPLAY_STRIP_PREFIX:-}
  if [[ -n "$strip_prefix" && "$p" == "$strip_prefix"* ]]; then
    p="${p#"$strip_prefix"}"
    p="${p#/}"
  fi
  if [[ "$p" == "$HOME" ]]; then
    printf '~'
  elif [[ "$p" == "$HOME/"* ]]; then
    printf '~/%s' "${p#"$HOME"/}"
  else
    printf '%s' "$p"
  fi
}

colorize() {
  local code=$1 text=$2
  if (( TX_USE_COLOR == 1 )); then
    printf '\033[%sm%s\033[0m' "$code" "$text"
  else
    printf '%s' "$text"
  fi
}

colorize_status() {
  local status=$1 text=$2
  case "$status" in
    running) colorize '32' "$text" ;;
    stopped) colorize '31' "$text" ;;
    missing) colorize '31' "$text" ;;
    *) printf '%s' "$text" ;;
  esac
}

completion_commands() {
  printf '%s\n' help ls kill kill-all init add remove edit doctor which config install completion autowork
}
completion_aliases() {
  [[ -f "$CONFIG_PATH" ]] || return 0
  load_config
  printf '%s\n' "${!ALIAS_TO_PATH[@]}" | sort
}

print_completion() {
  local shell=$1 command_name=${TX_COMPLETION_COMMAND:-tx}
  case "$shell" in
    bash)
      cat <<'EOF'
_tx_completion() {
  local cur cmd tx_bin commands aliases
  COMPREPLY=()
  tx_bin="${COMP_WORDS[0]}"
  cur="${COMP_WORDS[COMP_CWORD]}"
  commands="$($tx_bin __complete_commands 2>/dev/null)"
  aliases="$($tx_bin __complete_aliases 2>/dev/null)"
  if (( COMP_CWORD == 1 )); then
    COMPREPLY=( $(compgen -W "$commands $aliases" -- "$cur") )
    return 0
  fi
  cmd="${COMP_WORDS[1]}"
  case "$cmd" in
    which|kill|remove|edit|-k|--kill)
      COMPREPLY=( $(compgen -W "$aliases" -- "$cur") )
      ;;
    completion)
      COMPREPLY=( $(compgen -W "bash zsh fish" -- "$cur") )
      ;;
    add)
      compopt -o default 2>/dev/null || true
      ;;
  esac
}
EOF
      printf 'complete -F _tx_completion %q\n' "$command_name"
      ;;
    zsh)
      cat <<EOF
#compdef ${command_name}
_tx_completion() {
  local -a commands aliases
  commands=(\${(f)"\$(${command_name} __complete_commands 2>/dev/null)"})
  aliases=(\${(f)"\$(${command_name} __complete_aliases 2>/dev/null)"})
  if (( CURRENT == 2 )); then
    _describe 'tx commands' commands
    _describe 'tx aliases' aliases
  elif [[ \${words[2]} == (which|kill|remove|edit|-k|--kill) ]]; then
    _describe 'tx aliases' aliases
  elif [[ \${words[2]} == completion ]]; then
    _values 'shell' bash zsh fish
  else
    _files
  fi
}
compdef _tx_completion ${command_name}
EOF
      ;;
    fish)
      cat <<EOF
complete -c ${command_name} -f -n '__fish_use_subcommand' -a '(${command_name} __complete_commands; ${command_name} __complete_aliases)'
complete -c ${command_name} -f -n '__fish_seen_subcommand_from which kill remove edit -k --kill' -a '(${command_name} __complete_aliases)'
complete -c ${command_name} -f -n '__fish_seen_subcommand_from completion' -a 'bash zsh fish'
complete -c ${command_name} -n '__fish_seen_subcommand_from add' -a '(__fish_complete_directories)'
EOF
      ;;
    *)
      die "completion: expected bash, zsh, or fish"
      ;;
  esac
}

load_config() {
  [[ -f "$CONFIG_PATH" ]] || die "config not found: $CONFIG_PATH"

  ALIAS_TO_PATH=()
  PATH_TO_ALIASES=()
  PATH_ORDER=()
  declare -A vars=()
  local lineno=0 line key val keys path part
  local -a parts
  while IFS= read -r line || [[ -n "$line" ]]; do
    lineno=$((lineno + 1))
    line=${line%$'\r'}
    [[ -z "${line//[[:space:]]/}" ]] && continue
    [[ "$line" =~ ^[[:space:]]*# ]] && continue

    if [[ "$line" =~ ^[[:space:]]*([A-Z_][A-Z0-9_]*)=(.*)$ ]]; then
      key=${BASH_REMATCH[1]}
      val=${BASH_REMATCH[2]}
      vars[$key]=$(expand_vars "$val" vars)
      continue
    fi

    if [[ "$line" =~ ^[[:space:]]*([A-Za-z0-9_,-]+)[[:space:]]*=[[:space:]]*(.*)$ ]]; then
      keys=${BASH_REMATCH[1]}
      val=${BASH_REMATCH[2]}
      val=${val%"${val##*[![:space:]]}"}
      path=$(expand_vars "$val" vars)
      path=$(expand_tilde "$path")
      [[ -n "$path" ]] || die "config:$lineno: empty path"

      validate_alias_list "$keys" "config:$lineno"
      IFS=',' read -ra parts <<< "$keys"
      for part in "${parts[@]}"; do
        if [[ -n "${ALIAS_TO_PATH[$part]+x}" ]]; then
          die "config:$lineno: duplicate alias '$part' (already maps to ${ALIAS_TO_PATH[$part]})"
        fi
        ALIAS_TO_PATH[$part]=$path
      done

      if [[ -z "${PATH_TO_ALIASES[$path]+x}" ]]; then
        PATH_ORDER+=("$path")
        PATH_TO_ALIASES[$path]=$keys
      else
        PATH_TO_ALIASES[$path]+=",$keys"
      fi
      continue
    fi

    die "config:$lineno: cannot parse line: $line"
  done < "$CONFIG_PATH"
}

init_config() {
  if [[ -e "$CONFIG_PATH" ]]; then
    printf 'config exists: %s\n' "$CONFIG_PATH"
    return 0
  fi

  ensure_config_parent
  cat > "$CONFIG_PATH" <<'EOF'
# tx sessions
#
# Format:
#   VAR=value
#   alias[,alias2]=path
#
# Example:
#   WORK=~/git
#   app=$WORK/example-app
EOF
  printf 'created config: %s\n' "$CONFIG_PATH"
}

append_aliases_to_existing_path() {
  local keys=$1 target=$2
  local tmp line lineno=0 key val map_keys path done=0
  declare -A vars=()
  tmp=$(mktemp "${CONFIG_PATH}.tmp.XXXXXX")

  while IFS= read -r line || [[ -n "$line" ]]; do
    lineno=$((lineno + 1))
    line=${line%$'\r'}
    if [[ "$line" =~ ^[[:space:]]*([A-Z_][A-Z0-9_]*)=(.*)$ ]]; then
      key=${BASH_REMATCH[1]}
      val=${BASH_REMATCH[2]}
      vars[$key]=$(expand_vars "$val" vars)
      printf '%s\n' "$line" >> "$tmp"
      continue
    fi

    if (( done == 0 )) && [[ "$line" =~ ^[[:space:]]*([A-Za-z0-9_,-]+)[[:space:]]*=[[:space:]]*(.*)$ ]]; then
      map_keys=${BASH_REMATCH[1]}
      val=${BASH_REMATCH[2]}
      val=${val%"${val##*[![:space:]]}"}
      path=$(expand_vars "$val" vars)
      path=$(expand_tilde "$path")
      if [[ "$path" == "$target" ]]; then
        printf '%s,%s=%s\n' "$map_keys" "$keys" "$val" >> "$tmp"
        done=1
        continue
      fi
    fi

    printf '%s\n' "$line" >> "$tmp"
  done < "$CONFIG_PATH"

  if (( done == 0 )); then
    rm -f "$tmp"
    die "add: no existing config row found for $target"
  fi
  mv "$tmp" "$CONFIG_PATH"
}

add_alias() {
  [[ $# -ge 1 && $# -le 2 ]] || die "add: expected alias[,alias2] and optional directory, or a directory to prompt for aliases"
  local keys target part prompt_for_alias=0 first_path ending
  local -a parts

  first_path=$(expand_tilde "$1")
  if [[ $# -eq 1 && ( "$1" == "." || -d "$first_path" ) ]]; then
    target=$1
    prompt_for_alias=1
  elif [[ $# -eq 2 && ( "$1" == "." || -d "$first_path" ) ]]; then
    target=$1
    keys=$2
  else
    keys=$1
    target=${2:-$PWD}
  fi

  target=$(expand_tilde "$target")
  [[ -d "$target" ]] || die "add: target dir does not exist: $target"
  target=$(cd -- "$target" && pwd -P)

  if (( prompt_for_alias == 1 )); then
    keys=$(prompt_alias_list "$target")
  fi

  validate_alias_list "$keys" "add"

  if [[ -f "$CONFIG_PATH" ]]; then
    load_config
    IFS=',' read -ra parts <<< "$keys"
    for part in "${parts[@]}"; do
      if [[ -n "${ALIAS_TO_PATH[$part]+x}" ]]; then
        die "add: duplicate alias '$part' (already maps to ${ALIAS_TO_PATH[$part]})"
      fi
    done
  else
    init_config >/dev/null
  fi

  if [[ -n "${PATH_TO_ALIASES[$target]+x}" ]]; then
    append_aliases_to_existing_path "$keys" "$target"
    printf 'updated: %s,%s=%s\n' "${PATH_TO_ALIASES[$target]}" "$keys" "$target"
  else
    if [[ -s "$CONFIG_PATH" ]]; then
      ending=$(tail -c 1 "$CONFIG_PATH"; printf x)
      [[ "$ending" == $'\nx' ]] || printf '\n' >> "$CONFIG_PATH"
    fi
    printf '%s=%s\n' "$keys" "$target" >> "$CONFIG_PATH"
    printf 'added: %s=%s\n' "$keys" "$target"
  fi
}

rewrite_alias_row() {
  local mode=$1 alias=$2 replacement=${3:-}
  [[ -f "$CONFIG_PATH" ]] || die "$mode: config missing: $CONFIG_PATH"
  load_config

  local target tmp line key val map_keys path changed=0 kept_keys part new_part
  local -a parts kept_parts
  alias=$(resolve_alias "$alias")
  target=${ALIAS_TO_PATH[$alias]}
  tmp=$(mktemp "${CONFIG_PATH}.tmp.XXXXXX")
  declare -A vars=()

  while IFS= read -r line || [[ -n "$line" ]]; do
    line=${line%$'\r'}
    if [[ "$line" =~ ^[[:space:]]*([A-Z_][A-Z0-9_]*)=(.*)$ ]]; then
      key=${BASH_REMATCH[1]}
      val=${BASH_REMATCH[2]}
      vars[$key]=$(expand_vars "$val" vars)
      printf '%s\n' "$line" >> "$tmp"
      continue
    fi

    if [[ "$line" =~ ^[[:space:]]*([A-Za-z0-9_,-]+)[[:space:]]*=[[:space:]]*(.*)$ ]]; then
      map_keys=${BASH_REMATCH[1]}
      val=${BASH_REMATCH[2]}
      val=${val%"${val##*[![:space:]]}"}
      path=$(expand_vars "$val" vars)
      path=$(expand_tilde "$path")
      if [[ "$path" == "$target" ]]; then
        IFS=',' read -ra parts <<< "$map_keys"
        kept_parts=()
        for part in "${parts[@]}"; do
          if [[ "$part" == "$alias" ]]; then
            changed=1
            [[ "$mode" == "edit" ]] && kept_parts+=("$replacement")
          else
            kept_parts+=("$part")
          fi
        done
        if (( ${#kept_parts[@]} > 0 )); then
          kept_keys=""
          for new_part in "${kept_parts[@]}"; do
            [[ -n "$kept_keys" ]] && kept_keys+=","
            kept_keys+="$new_part"
          done
          printf '%s=%s\n' "$kept_keys" "$val" >> "$tmp"
        fi
        continue
      fi
    fi

    printf '%s\n' "$line" >> "$tmp"
  done < "$CONFIG_PATH"

  if (( changed == 0 )); then
    rm -f "$tmp"
    die "$mode: alias not found: $alias"
  fi

  mv "$tmp" "$CONFIG_PATH"
  if [[ "$mode" == "edit" ]]; then
    printf 'renamed: %s -> %s=%s\n' "$alias" "$replacement" "$target"
  else
    printf 'removed: %s=%s\n' "$alias" "$target"
  fi
}

remove_alias() {
  [[ $# -eq 1 ]] || die "remove: expected exactly one alias"
  rewrite_alias_row remove "$1"
}

edit_alias() {
  [[ $# -ge 1 && $# -le 2 ]] || die "edit: expected alias and optional new alias"
  [[ -f "$CONFIG_PATH" ]] || die "edit: config missing: $CONFIG_PATH"
  load_config

  local old_alias new_alias
  old_alias=$(resolve_alias "$1")
  if [[ $# -eq 2 ]]; then
    new_alias=$2
  else
    printf 'Rename %s to: ' "$old_alias" >&2
    IFS= read -r new_alias || die "edit: alias prompt cancelled"
  fi
  validate_alias_list "$new_alias" "edit"
  [[ "$new_alias" != "$old_alias" ]] || die "edit: new alias matches old alias: $old_alias"
  if [[ -n "${ALIAS_TO_PATH[$new_alias]+x}" ]]; then
    die "edit: duplicate alias '$new_alias' (already maps to ${ALIAS_TO_PATH[$new_alias]})"
  fi
  rewrite_alias_row edit "$old_alias" "$new_alias"
}

print_alias_path() {
  local alias
  alias=$(resolve_alias "$1")
  [[ -n "${ALIAS_TO_PATH[$alias]+x}" ]] || die "unknown alias: $alias"
  printf '%s\n' "${ALIAS_TO_PATH[$alias]}"
}

doctor_install() {
  sh "$(installer_path)"

  local home=${HOME:?HOME is required}
  local tmux_conf_target=${TMUX_CONF_TARGET:-$home/.tmux.conf}
  local tmux_helper_dir=${TMUX_HELPER_DIR:-$home/.tmux}
  local tx_bin_dir=${TX_BIN_DIR:-$home/.local/bin}
  local tx_bin_name=${TX_BIN_NAME:-tx}
  local tx_path="$tx_bin_dir/$tx_bin_name"
  local ok=1

  if [[ -f "$tmux_conf_target" ]]; then
    printf 'tmux.conf: %s\n' "$tmux_conf_target"
  else
    printf 'tmux.conf: missing (%s)\n' "$tmux_conf_target"
    ok=0
  fi

  for helper in git-status.sh short-path.sh; do
    if [[ -x "$tmux_helper_dir/$helper" ]]; then
      printf 'helper: %s\n' "$tmux_helper_dir/$helper"
    else
      printf 'helper: missing or not executable (%s)\n' "$tmux_helper_dir/$helper"
      ok=0
    fi
  done

  if [[ -x "$tx_path" ]]; then
    printf 'tx: %s\n' "$tx_path"
  else
    printf 'tx: missing or not executable (%s)\n' "$tx_path"
    ok=0
  fi

  case ":$PATH:" in
    *":$tx_bin_dir:"*) printf 'PATH: includes %s\n' "$tx_bin_dir" ;;
    *) printf 'PATH: missing %s\n' "$tx_bin_dir"; ok=0 ;;
  esac

  if [[ -f "$tmux_conf_target" ]]; then
    if grep -F -- "$tmux_helper_dir/short-path.sh" "$tmux_conf_target" >/dev/null || grep -F -- "$tmux_helper_dir/git-status.sh" "$tmux_conf_target" >/dev/null; then
      printf 'tmux.conf: references status helpers\n'
    else
      printf 'tmux.conf: no status helper references\n'
    fi
  fi

  (( ok == 1 ))
}

doctor() {
  local ok=1 p alias_str a missing=0
  local -a parts

  if command -v "$TMUX_BIN" >/dev/null 2>&1; then
    printf 'tmux: %s\n' "$(command -v "$TMUX_BIN")"
  else
    printf 'tmux: missing (%s)\n' "$TMUX_BIN"
    ok=0
  fi

  if [[ -f "$CONFIG_PATH" ]]; then
    printf 'config: %s\n' "$CONFIG_PATH"
    load_config
  else
    printf 'config: missing (%s)\n' "$CONFIG_PATH"
    return 1
  fi

  for p in "${PATH_ORDER[@]}"; do
    [[ -d "$p" ]] && continue
    missing=$((missing + 1))
    alias_str=${PATH_TO_ALIASES[$p]}
    IFS=',' read -ra parts <<< "$alias_str"
    for a in "${parts[@]}"; do
      printf 'missing target: %s -> %s\n' "$a" "$p"
    done
  done

  if (( missing == 0 )); then
    printf 'targets: ok (%d configured paths)\n' "${#PATH_ORDER[@]}"
  else
    ok=0
  fi

  (( ok == 1 ))
}

list_sessions() {
  local running=""
  running=$("$TMUX_BIN" list-sessions -F '#{session_name}' 2>/dev/null || true)

  local -a row_aliases=() row_aliases_plain=() row_paths=()
  local total=0 running_count=0 missing_count=0
  local p alias_str a disp dir_exists status item colored_item joined colored_joined
  local -a parts colored_parts plain_parts

  for p in "${PATH_ORDER[@]}"; do
    alias_str=${PATH_TO_ALIASES[$p]}
    IFS=',' read -ra parts <<< "$alias_str"
    disp=$(display_path "$p")
    dir_exists=1
    [[ -d "$p" ]] || dir_exists=0
    colored_parts=()
    plain_parts=()
    for a in "${parts[@]}"; do
      total=$((total + 1))
      if (( ! dir_exists )); then
        status="missing"
        missing_count=$((missing_count + 1))
      elif [[ -n "$running" ]] && printf '%s\n' "$running" | grep -qx -- "$a"; then
        status="running"
        running_count=$((running_count + 1))
      else
        status="stopped"
      fi
      item=$a
      colored_item=$(colorize_status "$status" "$item")
      colored_parts+=("$colored_item")
      plain_parts+=("$item")
    done
    joined=""
    colored_joined=""
    for item in "${plain_parts[@]}"; do
      [[ -n "$joined" ]] && joined+=", "
      joined+="$item"
    done
    for item in "${colored_parts[@]}"; do
      [[ -n "$colored_joined" ]] && colored_joined+=", "
      colored_joined+="$item"
    done
    row_aliases+=("$colored_joined")
    row_aliases_plain+=("$joined")
    row_paths+=("$disp")
  done

  printf 'tx sessions\n'
  printf 'config: %s\n\n' "$CONFIG_PATH"

  if (( total == 0 )); then
    printf '  (no aliases configured)\n'
    return 0
  fi

  local alias_w=7 path_w=4
  local i n=${#row_aliases[@]}
  for (( i=0; i<n; i++ )); do
    (( ${#row_aliases_plain[i]} > alias_w )) && alias_w=${#row_aliases_plain[i]}
    (( ${#row_paths[i]}          > path_w  )) && path_w=${#row_paths[i]}
  done

  local alias_dash path_dash
  printf -v alias_dash '%*s' "$alias_w" ''
  printf -v path_dash  '%*s' "$path_w"  ''
  alias_dash=${alias_dash// /-}
  path_dash=${path_dash// /-}

  printf '  %-*s  %s\n' "$alias_w" 'Aliases' 'Path'
  printf '  %s  %s\n' "$alias_dash" "$path_dash"
  local pad
  for (( i=0; i<n; i++ )); do
    pad=$((alias_w - ${#row_aliases_plain[i]}))
    printf '  %s' "${row_aliases[i]}"
    printf '%*s  %s\n' "$pad" '' "${row_paths[i]}"
  done

  printf '\n%d configured; %d running; %d missing target dirs.\n' \
    "$total" "$running_count" "$missing_count"
}

resolve_alias() {
  local requested=$1
  if [[ -n "${ALIAS_TO_PATH[$requested]+x}" ]]; then
    printf '%s\n' "$requested"
    return 0
  fi

  local p alias_str a match="" best=""
  local -a parts matches=()
  for p in "${PATH_ORDER[@]}"; do
    alias_str=${PATH_TO_ALIASES[$p]}
    IFS=',' read -ra parts <<< "$alias_str"
    for a in "${parts[@]}"; do
      if [[ "$a" == "$requested"* ]]; then
        matches+=("$a")
        match=$a
      fi
    done
  done

  case ${#matches[@]} in
    0)
      die "unknown alias: $requested"
      ;;
    1)
      printf '%s\n' "$match"
      ;;
    *)
      best=${matches[0]}
      for a in "${matches[@]:1}"; do
        if (( ${#a} < ${#best} )) || { (( ${#a} == ${#best} )) && [[ "$a" < "$best" ]]; }; then
          best=$a
        fi
      done
      printf '%s\n' "$best"
      ;;
  esac
}

kill_session() {
  local alias
  alias=$(resolve_alias "$1")
  [[ -n "${ALIAS_TO_PATH[$alias]+x}" ]] || die "unknown alias: $alias"
  if "$TMUX_BIN" has-session -t "=$alias" 2>/dev/null; then
    "$TMUX_BIN" kill-session -t "=$alias"
    printf 'killed: %s\n' "$alias"
  else
    printf 'not running: %s\n' "$alias"
  fi
}

kill_all_sessions() {
  local running="" current="" p alias_str a
  local -a parts aliases=() targets=()
  local total=0 killed=0 not_running=0 i

  running=$("$TMUX_BIN" list-sessions -F '#{session_name}' 2>/dev/null || true)
  if [[ -n "${TMUX:-}" ]]; then
    current=$("$TMUX_BIN" display-message -p '#S' 2>/dev/null || true)
  fi

  for p in "${PATH_ORDER[@]}"; do
    alias_str=${PATH_TO_ALIASES[$p]}
    IFS=',' read -ra parts <<< "$alias_str"
    for a in "${parts[@]}"; do
      aliases+=("$a")
      targets+=("$a")
      total=$((total + 1))
    done
  done

  if (( total == 0 )); then
    printf 'no aliases configured\n'
    return 0
  fi

  # If invoked from inside one of the target sessions, kill it last so the
  # command can clean up the others before its own pane disappears.
  if [[ -n "$current" ]]; then
    targets=()
    for a in "${aliases[@]}"; do
      [[ "$a" == "$current" ]] || targets+=("$a")
    done
    for a in "${aliases[@]}"; do
      [[ "$a" == "$current" ]] && targets+=("$a")
    done
  fi

  for (( i=0; i<${#targets[@]}; i++ )); do
    a=${targets[i]}
    if [[ -n "$running" ]] && printf '%s\n' "$running" | grep -qx -- "$a"; then
      "$TMUX_BIN" kill-session -t "=$a"
      printf 'killed: %s\n' "$a"
      killed=$((killed + 1))
    else
      not_running=$((not_running + 1))
    fi
  done

  printf '%d killed; %d not running.\n' "$killed" "$not_running"
}

attach_session() {
  local alias
  alias=$(resolve_alias "$1")
  [[ -n "${ALIAS_TO_PATH[$alias]+x}" ]] || die "unknown alias: $alias"
  local target=${ALIAS_TO_PATH[$alias]}
  [[ -d "$target" ]] || die "target dir does not exist: $target"

  local shell_path=${SHELL:-/bin/bash}
  local startup
  startup="cd -- $(printf '%q' "$target") && exec $(printf '%q' "$shell_path")"

  if ! "$TMUX_BIN" has-session -t "=$alias" 2>/dev/null; then
    "$TMUX_BIN" new-session -d -s "$alias" -c "$target" "$startup"
  else
    # Existing session (e.g. restored by tmux-continuum/resurrect) may be in
    # the wrong cwd. If the active pane is an idle shell in the wrong dir,
    # self-heal by sending `cd <target>` before attaching.
    local cur_path="" cur_cmd=""
    cur_path=$("$TMUX_BIN" display-message -p -t "=$alias" '#{pane_current_path}' 2>/dev/null || true)
    cur_cmd=$("$TMUX_BIN" display-message -p -t "=$alias" '#{pane_current_command}' 2>/dev/null || true)
    if [[ "$cur_path" != "$target" ]] && [[ "$cur_cmd" =~ ^(bash|zsh|sh|fish|dash)$ ]]; then
      "$TMUX_BIN" send-keys -t "=$alias" "cd -- $(printf '%q' "$target")" C-m
    fi
  fi

  if [[ -n "${TMUX:-}" ]]; then
    exec "$TMUX_BIN" switch-client -t "=$alias"
  fi
  exec "$TMUX_BIN" attach-session -t "=$alias"
}

# --- tx autowork ---------------------------------------------------------------
# tx/tmux is the default way to run pi-autowork; systemd is optional.
# Both use the same
# per-repository runner lock, so they never work on a repository at once.
# Every command takes a runner name (sierra), a repository path, or `.`.
AUTOWORK_PREFIX=pi-autowork-
SYSTEMCTL_BIN=${PI_AUTOWORK_SYSTEMCTL:-systemctl}
JOURNALCTL_BIN=${TX_JOURNALCTL:-journalctl}
AUTOWORK_ENV_DIR=${PI_AUTOWORK_ENV_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/pi-autowork}
AUTOWORK_STATE_ROOT=${PI_AUTOWORK_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/pi-autowork}

autowork_script() {
  if [[ -n "${PI_AUTOWORK_SCRIPT:-}" ]]; then
    [[ -f "$PI_AUTOWORK_SCRIPT" ]] || die "autowork: PI_AUTOWORK_SCRIPT not found: $PI_AUTOWORK_SCRIPT"
    printf '%s\n' "$PI_AUTOWORK_SCRIPT"
    return 0
  fi
  local unit=${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/pi-autowork@.service script
  if [[ -f "$unit" ]]; then
    script=$(sed -n 's/^ExecStart=[^ ]*bash \([^ ]*pi-autowork\.sh\) .*/\1/p' "$unit" | head -n 1)
    [[ -n "$script" && -f "$script" ]] && { printf '%s\n' "$script"; return 0; }
  fi
  script="$(script_dir)/../scripts/pi-autowork.sh"
  [[ -f "$script" ]] || die "autowork: pi-autowork.sh not found; install the autowork Pi package or set PI_AUTOWORK_SCRIPT"
  printf '%s\n' "$(cd -P "$(dirname -- "$script")" && pwd)/pi-autowork.sh"
}

# Same instance name as pi-autowork.sh --install-service: the directory name.
autowork_instance() {
  local name
  name=$(basename -- "$1")
  if [[ ! "$name" =~ ^[A-Za-z0-9._-]+$ ]]; then
    name=$(systemd-escape -- "$name")
  fi
  printf '%s\n' "$name"
}

# tmux rewrites '.' and ':' in session names; keep names predictable.
autowork_session() {
  local name=$1
  name=${name//./_}
  printf '%s%s\n' "$AUTOWORK_PREFIX" "${name//:/_}"
}

autowork_repo() {
  local dir=$1 root
  [[ -d "$dir" ]] || die "autowork: not a directory: $dir"
  root=$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null) || die "autowork: not inside a Git repository: $dir"
  printf '%s\n' "$root"
}

# A path (or .) names its repository; a bare name finds the repository of that
# runner's tmux session or service.
autowork_resolve() {
  local target=$1 repo="" session
  if [[ "$target" == */* || "$target" == . || "$target" == .. || -d "$target" ]]; then
    autowork_repo "$target"
    return 0
  fi
  target=${target#"$AUTOWORK_PREFIX"}
  session=$(autowork_session "$target")
  if command -v "$TMUX_BIN" >/dev/null 2>&1; then
    repo=$("$TMUX_BIN" show-options -qv -t "=$session:" @pi_autowork_repo 2>/dev/null || true)
  fi
  if [[ -z "$repo" && -f "$AUTOWORK_ENV_DIR/$target.env" ]]; then
    repo=$(sed -n 's/^PI_AUTOWORK_REPO=//p' "$AUTOWORK_ENV_DIR/$target.env" | head -n 1)
  fi
  [[ -n "$repo" ]] || die "autowork: no runner named $target; pass a repository path, or see: tx autowork ls"
  printf '%s\n' "$repo"
}

autowork_service_state() {
  local unit="pi-autowork@$1.service" state
  command -v "$SYSTEMCTL_BIN" >/dev/null 2>&1 || { printf 'none\n'; return 0; }
  if "$SYSTEMCTL_BIN" --user is-active --quiet "$unit" 2>/dev/null; then
    printf 'active\n'
  elif "$SYSTEMCTL_BIN" --user is-enabled --quiet "$unit" 2>/dev/null; then
    printf 'enabled\n'
  else
    state=$("$SYSTEMCTL_BIN" --user is-failed "$unit" 2>/dev/null || true)
    [[ "$state" == failed ]] && printf 'failed\n' || printf 'none\n'
  fi
}

autowork_start() {
  [[ $# -eq 1 ]] || die "autowork: expected exactly one runner name, repository path, or ."
  require_tmux
  local root instance session service mode="" command shell_path=${SHELL:-/bin/bash}
  root=$(autowork_resolve "$1")
  instance=$(autowork_instance "$root")
  session=$(autowork_session "$instance")
  service=$(autowork_service_state "$instance")
  if "$TMUX_BIN" has-session -t "=$session" 2>/dev/null; then
    local owner
    owner=$("$TMUX_BIN" show-options -qv -t "=$session:" @pi_autowork_repo 2>/dev/null || true)
    [[ -z "$owner" || "$owner" == "$root" ]] ||
      die "autowork: session $session already runs $owner; two repositories cannot share the name $instance"
    mode=$("$TMUX_BIN" show-options -qv -t "=$session:" @pi_autowork_mode 2>/dev/null || true)
    if [[ "$mode" == journal && "$service" != active && "$service" != enabled ]]; then
      # The service no longer runs the repository: run it here instead of watching.
      "$TMUX_BIN" kill-session -t "=$session"
      printf 'tx: pi-autowork@%s.service no longer runs; replacing the journal view with a runner\n' "$instance" >&2
    fi
  fi
  if ! "$TMUX_BIN" has-session -t "=$session" 2>/dev/null; then
    case "$service" in
      active|enabled)
        # The service owns the repository; this session follows its journal instead.
        printf -v command '%q --user -u %q -n 200 -f -o cat; exec %q' \
          "$JOURNALCTL_BIN" "pi-autowork@$instance.service" "$shell_path"
        mode=journal
        printf 'tx: %s follows pi-autowork@%s.service, which runs this repository; closing it leaves the service running\n' \
          "$session" "$instance" >&2
        ;;
      *)
        local script
        script=$(autowork_script)
        # The pane outlives the runner so its last lines stay readable.
        # shellcheck disable=SC2016  # $? and $status expand inside the tmux pane
        printf -v command 'bash %q --repo %q; status=$?; printf "\\npi-autowork exited with status %%s.\\n" "$status"; exec %q' \
          "$script" "$root" "$shell_path"
        mode=runner
        printf 'tx: started %s for %s\n' "$session" "$root" >&2
        ;;
    esac
    "$TMUX_BIN" new-session -d -s "$session" -c "$root" "$command"
    "$TMUX_BIN" set-option -q -t "=$session:" @pi_autowork_repo "$root"
    "$TMUX_BIN" set-option -q -t "=$session:" @pi_autowork_mode "$mode"
  fi
  [[ "${TX_NO_ATTACH:-0}" == 1 ]] && return 0
  if [[ -n "${TMUX:-}" ]]; then
    exec "$TMUX_BIN" switch-client -t "=$session"
  fi
  exec "$TMUX_BIN" attach-session -t "=$session"
}

# Health per repository from the runner's own status.json (written every cycle; the
# same record as pi-autowork.sh --fleet). One TSV row per runner:
# repo, state, minutes in it, running, waiting, held, blockers grouped by kind
# (joined by \x1f; "ID (n)" means n waiting tasks depend on it), held IDs and causes;
# "-" marks an empty field, since `read` would collapse two adjacent tabs.
autowork_health() {
  command -v jq >/dev/null 2>&1 || return 0
  local folder pid
  for folder in "$AUTOWORK_STATE_ROOT"/*/; do
    [[ -f "$folder/status.json" || -f "$folder/runner.json" ]] || continue
    pid=$(jq -r '.pid // empty' "$folder/runner.json" 2>/dev/null || true)
    jq -rs --arg now "$(date +%s)" --arg alive "$([[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null && echo 1)" '
      def short: tostring | gsub("\\s+"; " ")
        | if length > 32 then (.[0:32] | sub(" [^ ]*$"; "")) + "..." else . end;
      def kinds: {runner: "runner", held: "held", contract: "entry changed", claim: "claimed elsewhere",
                  outside: "outside Now/Next", cycle: "dependency cycle"};
      def causes: {blocker: "blocker", scope: "outside Touches", scope_request: "needs files",
                   overlap: "overlap", report: "bad report", conflict: "conflict", validation: "validation",
                   crash: "crashed", launch: "launch failed", contract_changed: "entry changed", moved: "main moved"};
      def cause: if . then " " + (causes[.] // .) else "" end;
      def none: if . == "" then "-" else . end;
      (.[0] // {}) as $s | (.[1] // {}) as $r | ($s.repo // $r.repo) as $repo | select($repo)
      | [$repo,
         (if $alive != "1" then "not running" else ($s.state // "starting") end),
         (if $s.since and $alive == "1" then ((($now | tonumber) - $s.since) / 60 | floor | tostring) else "-" end),
         ($s.active_workers // 0 | tostring), ($s.waiting // 0 | tostring), (($s.held // []) | length | tostring),
         ([($s.roots // [])[] | select(.kind | IN("runner", "held", "contract", "claim", "outside", "cycle"))]
          | group_by(.kind) | sort_by(.[0].kind | {runner: 0, cycle: 1, held: 2, contract: 3, claim: 4, outside: 5}[.])
          | map((kinds[.[0].kind] // .[0].kind) + ": "
                + (map((.id | short) + (if .kind == "held" then (.cause | cause) else "" end)
                       + " (\(.blocks // 0))") | join(", ")))
          | join("\u001f") | none),
         ([($s.held // [])[] | (.task | short) + (.cause | cause)] | join(", ") | none)]
      | @tsv' "$folder/status.json" "$folder/runner.json" 2>/dev/null || true
  done
}

autowork_duration() {  # minutes -> 45m, 4h40m
  local m=$1
  if (( m >= 60 )); then printf '%dh%02dm\n' $((m / 60)) $((m % 60)); else printf '%dm\n' "$m"; fi
}

autowork_width() {
  local cols=${COLUMNS:-}
  [[ -z "$cols" && -t 1 ]] && cols=$(tput cols 2>/dev/null || true)
  printf '%s\n' "${cols:-100}"
}

autowork_fit() {  # print $2 cut to width $1
  local width=$1 text=$2
  (( ${#text} > width )) && text="${text:0:$((width - 3))}..."
  printf '%s\n' "$text"
}

autowork_state_color() {  # ANSI color for a runner state
  case "$1" in
    working|idle) printf '32' ;;
    blocked|paused|starting) printf '33' ;;
    *) printf '31' ;;
  esac
}

autowork_list() {
  local brief=1
  case "${1:-}" in
    --brief|-b) shift ;;
    --long|-v|--verbose) brief=0; shift ;;
  esac
  [[ $# -eq 0 ]] || die "autowork ls: takes only --long (or --brief, the default)"
  local -A mode=() repo=() state=()
  local name path attached kind unit sub
  if command -v "$TMUX_BIN" >/dev/null 2>&1; then
    while IFS=$'\t' read -r name path attached kind; do
      [[ "$name" == "$AUTOWORK_PREFIX"* ]] || continue
      name=${name#"$AUTOWORK_PREFIX"}
      [[ "$kind" == journal ]] && continue  # a view of a service runner, listed with the service
      mode[$name]=tmux; repo[$name]=$path
      state[$name]=$([[ "$attached" == 0 ]] && echo detached || echo attached)
    done < <("$TMUX_BIN" list-sessions -F "#{session_name}	#{@pi_autowork_repo}	#{session_attached}	#{@pi_autowork_mode}" 2>/dev/null || true)
  fi
  if command -v "$SYSTEMCTL_BIN" >/dev/null 2>&1; then
    while read -r unit _ _ sub _; do
      [[ "$unit" == pi-autowork@*.service ]] || continue
      name=${unit#pi-autowork@}; name=${name%.service}
      path=$(sed -n 's/^PI_AUTOWORK_REPO=//p' "$AUTOWORK_ENV_DIR/$name.env" 2>/dev/null || true)
      if [[ -n "${mode[$name]+x}" ]]; then
        mode[$name]="tmux+service"; state[$name]+=", service $sub"
      else
        mode[$name]=service; repo[$name]=$path; state[$name]=$sub
      fi
    done < <("$SYSTEMCTL_BIN" --user list-units 'pi-autowork@*' --all --plain --no-legend 2>/dev/null || true)
  fi
  if (( ${#mode[@]} == 0 )); then
    printf 'pi-autowork runners: none\n  start one with: tx autowork start [repo]\n'
    return 0
  fi
  local -A health=() since=() counts=() blockers=() held=()
  local hrepo hstate hmin hrun hwait hheld hblock hids
  while IFS=$'\t' read -r hrepo hstate hmin hrun hwait hheld hblock hids; do
    [[ -n "$hrepo" ]] || continue
    [[ "$hmin" == - ]] && hmin=""
    [[ "$hblock" == - ]] && hblock=""
    [[ "$hids" == - ]] && hids=""
    health[$hrepo]=$hstate
    since[$hrepo]=$hmin
    counts[$hrepo]="$hrun running, $hwait waiting"
    [[ "$hheld" == 0 ]] || counts[$hrepo]+=", $hheld held"
    blockers[$hrepo]=$hblock
    held[$hrepo]=$hids
  done < <(autowork_health)

  local width key st label summary="" color
  width=$(autowork_width)
  local -A tally=()
  local -a names
  mapfile -t names < <(printf '%s\n' "${!mode[@]}" | sort)
  for name in "${names[@]}"; do
    key=${repo[$name]:-'(no repository)'}
    st=${health[$key]:-unknown}
    tally[$st]=$(( ${tally[$st]:-0} + 1 ))
  done
  local part
  for st in working idle paused blocked stalled "not running" "not cycling" starting unknown; do
    [[ -n "${tally[$st]:-}" ]] || continue
    part="${tally[$st]} $st"
    (( TX_USE_COLOR )) && part=$'\033'"[$(autowork_state_color "$st")m$part"$'\033'"[0m"
    summary+="${summary:+, }$part"
  done
  printf 'pi-autowork runners: %d (%s)\n' "${#names[@]}" "$summary"

  if (( brief )); then
    local name_w=4 row padded
    for name in "${names[@]}"; do (( ${#name} > name_w )) && name_w=${#name}; done
    for name in "${names[@]}"; do
      key=${repo[$name]:-'(no repository)'}
      st=${health[$key]:-unknown}
      label=$st
      [[ -n "${since[$key]:-}" ]] && label+=" $(autowork_duration "${since[$key]}")"
      printf -v padded '%-14s' "$label"
      row=$(autowork_fit "$width" "$(printf '  %-*s  %-7s  %s  %s' "$name_w" "$name" "${mode[$name]}" "$padded" "${counts[$key]:--}")")
      if (( TX_USE_COLOR )); then
        # Pad first, then color, so escape codes never shift the columns.
        row=${row/"  $padded  "/"  "$'\033'"[$(autowork_state_color "$st")m$padded"$'\033'"[0m  "}
      fi
      printf '%s\n' "$row"
    done
    autowork_fit "$width" "More: tx autowork ls --long   tx autowork status <name>   tx pi-autowork-<name>"
    return 0
  fi

  local line b
  for name in "${names[@]}"; do
    key=${repo[$name]:-'(no repository)'}
    st=${health[$key]:-unknown}
    color=$(autowork_state_color "$st")
    label=$st
    [[ -n "${since[$key]:-}" ]] && label+=" $(autowork_duration "${since[$key]}")"
    printf '\n'
    line="$name  ${mode[$name]}  "
    if (( TX_USE_COLOR )); then
      printf '%s\033[%sm%s\033[0m\n' "$line" "$color" "$label"
    else
      autowork_fit "$width" "$line$label"
    fi
    autowork_fit "$width" "  tx $(autowork_session "$name")  ${counts[$key]:-no status yet}"
    if [[ -n "${blockers[$key]:-}" && "$st" != working ]]; then
      while IFS= read -r b; do
        [[ -n "$b" ]] && autowork_fit "$width" "  $b"
      done < <(printf '%s\n' "${blockers[$key]}" | tr '\037' '\n')
    elif [[ -n "${held[$key]:-}" ]]; then
      autowork_fit "$width" "  held: ${held[$key]}"
    fi
  done
  printf '\n'
  autowork_fit "$width" "(n) = waiting tasks that depend on it. More: tx autowork status <name>"
}

autowork_status() {
  [[ $# -le 1 ]] || die "autowork status: expected at most one runner name, repository path, or ."
  local root script
  root=$(autowork_resolve "${1:-.}")
  script=$(autowork_script)
  exec bash "$script" --repo "$root" --status
}

autowork_logs() {
  local follow=0
  if [[ "${1:-}" == -f || "${1:-}" == --follow ]]; then
    follow=1
    shift
  fi
  [[ $# -le 1 ]] || die "autowork logs: expected [-f] and at most one runner name, repository path, or ."
  local root instance session lines=${TX_AUTOWORK_LOG_LINES:-200}
  root=$(autowork_resolve "${1:-.}")
  instance=$(autowork_instance "$root")
  session=$(autowork_session "$instance")
  if command -v "$TMUX_BIN" >/dev/null 2>&1 && "$TMUX_BIN" has-session -t "=$session" 2>/dev/null; then
    if (( follow )); then
      TX_NO_ATTACH=0 autowork_start "$root"
    fi
    "$TMUX_BIN" capture-pane -p -J -S "-$lines" -t "=$session:"
    return 0
  fi
  case "$(autowork_service_state "$instance")" in
    none) die "autowork logs: no tmux session or service runs $root" ;;
  esac
  if (( follow )); then
    exec "$JOURNALCTL_BIN" --user -u "pi-autowork@$instance.service" -n "$lines" -f -o cat
  fi
  exec "$JOURNALCTL_BIN" --user -u "pi-autowork@$instance.service" -n "$lines" --no-pager -o cat
}

autowork_stop() {
  [[ $# -eq 1 ]] || die "autowork stop: expected exactly one runner name, repository path, or ."
  require_tmux
  local root session instance
  root=$(autowork_resolve "$1")
  instance=$(autowork_instance "$root")
  session=$(autowork_session "$instance")
  if ! "$TMUX_BIN" has-session -t "=$session" 2>/dev/null; then
    case "$(autowork_service_state "$instance")" in
      active|enabled) die "autowork stop: $instance runs as a service; stop it with: systemctl --user stop pi-autowork@$instance" ;;
    esac
    die "autowork stop: no tmux session $session"
  fi
  if [[ "$("$TMUX_BIN" show-options -qv -t "=$session:" @pi_autowork_mode 2>/dev/null || true)" == journal ]]; then
    "$TMUX_BIN" kill-session -t "=$session"
    printf 'tx: closed %s; pi-autowork@%s.service keeps running (stop it with: systemctl --user stop pi-autowork@%s)\n' \
      "$session" "$instance" "$instance" >&2
    return 0
  fi
  local pane_pid
  pane_pid=$("$TMUX_BIN" display-message -p -t "=$session:" '#{pane_pid}')
  # Ctrl-C reaches the runner as SIGINT: it pauses live workers and stops cleanly.
  "$TMUX_BIN" send-keys -t "=$session:" C-c
  local deadline=$((SECONDS + ${TX_AUTOWORK_STOP_TIMEOUT:-300}))
  while pgrep -P "$pane_pid" -f 'pi-autowork\.sh' >/dev/null 2>&1; do
    if (( SECONDS >= deadline )); then
      die "autowork stop: the runner in $session is still stopping; check it with: tx autowork logs $instance"
    fi
    sleep 1
  done
  if "$TMUX_BIN" has-session -t "=$session" 2>/dev/null; then
    "$TMUX_BIN" kill-session -t "=$session"
  fi
  printf 'tx: stopped %s\n' "$session" >&2
}

autowork_help() {
  cat <<'EOF'
Usage: tx autowork <command>

pi-autowork runs each repository's TODO.md queue with Pi workers in tx/tmux by
default; a systemd service is optional. A target is a runner
name (sierra), a repository path, or . for the current repository.

  tx autowork ls [--long]    One line per runner: state, for how long, workers;
                             --long adds the tx command and what each one waits on,
                             (n) = waiting tasks that depend on a blocker
  tx autowork status [target]
                             One runner's full status: tasks, workers, blockers
  tx autowork logs [-f] [target]
                             Recent output (service journal or tmux pane); -f follows
  tx autowork start [target]
                             Open/start a runner; defaults to the current repository
  tx autowork <target>       Open the runner's tmux session pi-autowork-<name>: attach,
  tx pi-autowork-<name>      or start a tmux runner; for a service runner it follows
                             the service journal and leaves the service running
  tx autowork stop <target>  Ctrl+C a tmux runner (workers resume later on the same
                             attempt) and close its session; closes a journal view
  tx autowork                The live TUI on a terminal: every runner, its blockers and
                             log, with keys to open, start, stop, install or remove a
                             service, set aside a held task and answer blockers
                             (needs uv; TX_AUTOWORK_TUI=0 prints this help instead)
  tx autowork web [--port N] [--host H] [--view-only]
                             The TUI in a web browser (default http://127.0.0.1:8765, this
                             machine only); --view-only serves it without control keys
  tx autowork help           This help

Examples:
  tx autowork
  tx autowork ls
  tx autowork status india
  tx pi-autowork-sierra
  tx autowork start
  tx autowork .
EOF
}

# Bare `tx autowork` on a terminal: the live TUI (pi-autowork/pi_autowork/tui.py in the
# same release as the runner script), through uv so the runner stays stdlib-only.
AUTOWORK_TEXTUAL=${TX_AUTOWORK_TEXTUAL:-textual==8.2.8}
AUTOWORK_TEXTUAL_SERVE=${TX_AUTOWORK_TEXTUAL_SERVE:-textual-serve==1.1.3}

# The release that holds the TUI: next to the runner script the service runs.
autowork_tui_file() {  # $1 = file under pi-autowork/pi_autowork; prints its path or why not
  local script root
  script=$(autowork_script 2>/dev/null) || { echo "!pi-autowork.sh not found"; return; }
  root=$(cd -P "$(dirname -- "$script")/.." && pwd)
  if [[ -f "$root/pi-autowork/pi_autowork/$1" ]]; then
    printf '%s\n%s\n' "$root/pi-autowork/pi_autowork/$1" "$script"
  else
    echo "!this pi-autowork release ($root) has no $1 yet; update the package"
  fi
}

autowork_web() {
  local found file script
  found=$(autowork_tui_file tui_web.py)
  [[ "$found" != '!'* ]] || die "autowork web: ${found#!}"
  command -v uv >/dev/null 2>&1 || die "autowork web: needs uv (https://docs.astral.sh/uv/)"
  file=$(sed -n 1p <<<"$found"); script=$(sed -n 2p <<<"$found")
  printf 'tx: serving the pi-autowork TUI; open the URL below (Ctrl+C stops the server)\n' >&2
  exec uv run --quiet --no-project --with "$AUTOWORK_TEXTUAL" --with "$AUTOWORK_TEXTUAL_SERVE" python3 "$file" \
    --tx "$(script_dir)/$(basename -- "${BASH_SOURCE[0]}")" --script "$script" "$@"
}

autowork_tui() {
  local script root tui why=""
  if [[ "${TX_AUTOWORK_TUI:-1}" == 0 || ! -t 0 || ! -t 1 ]]; then
    return 1
  fi
  script=$(autowork_script 2>/dev/null) || why="pi-autowork.sh not found"
  if [[ -z "$why" ]]; then
    root=$(cd -P "$(dirname -- "$script")/.." && pwd)
    tui="$root/pi-autowork/pi_autowork/tui.py"
    [[ -f "$tui" ]] || why="this pi-autowork release ($root) has no TUI yet; update the package"
  fi
  [[ -n "$why" ]] || command -v uv >/dev/null 2>&1 || why="the TUI needs uv (https://docs.astral.sh/uv/)"
  if [[ -n "$why" ]]; then
    printf 'tx: no TUI: %s\n\n' "$why" >&2
    return 1
  fi
  exec uv run --quiet --no-project --with "$AUTOWORK_TEXTUAL" python3 "$tui" \
    --tx "$(script_dir)/$(basename -- "${BASH_SOURCE[0]}")" --script "$script"
}

autowork_main() {
  if [[ $# -eq 0 ]]; then
    autowork_tui || autowork_help
    return 0
  fi
  case "$1" in
    help|-h|--help) autowork_help ;;
    ls|--list|-l) shift; autowork_list "$@" ;;
    web) shift; autowork_web "$@" ;;
    status) shift; autowork_status "$@" ;;
    logs) shift; autowork_logs "$@" ;;
    start)
      shift
      [[ $# -le 1 ]] || die "autowork start: expected at most one runner name, repository path, or ."
      autowork_start "${1:-.}"
      ;;
    stop) shift; autowork_stop "$@" ;;
    *) autowork_start "$@" ;;
  esac
}

main() {
  if [[ $# -eq 0 ]]; then
    print_help >&2
    exit 1
  fi

  case "$1" in
    -h|--help|help)
      print_help
      return 0
      ;;
  esac

  case "$1" in
    init)
      [[ $# -eq 1 ]] || die "init: takes no arguments"
      init_config
      ;;
    config)
      [[ $# -eq 1 ]] || die "config: takes no arguments"
      print_config_path
      ;;
    install)
      shift
      run_installer "$@"
      ;;
    completion)
      shift
      [[ $# -eq 1 ]] || die "completion: expected exactly one shell: bash, zsh, or fish"
      print_completion "$1"
      ;;
    __complete_aliases)
      [[ $# -eq 1 ]] || die "__complete_aliases: takes no arguments"
      completion_aliases
      ;;
    __complete_commands)
      [[ $# -eq 1 ]] || die "__complete_commands: takes no arguments"
      completion_commands
      ;;
    add)
      shift
      add_alias "$@"
      ;;
    remove)
      shift
      remove_alias "$@"
      ;;
    edit)
      shift
      edit_alias "$@"
      ;;
    doctor)
      if [[ $# -eq 2 && "$2" == "--install" ]]; then
        doctor_install
      else
        [[ $# -eq 1 ]] || die "doctor: takes no arguments, or exactly --install"
        doctor
      fi
      ;;
    which)
      shift
      [[ $# -eq 1 ]] || die "which: expected exactly one alias"
      load_config
      print_alias_path "$1"
      ;;
    autowork)
      shift
      autowork_main "$@"
      ;;
    -l|--list|ls)
      [[ $# -eq 1 ]] || die "ls: takes no arguments"
      require_tmux
      load_config
      list_sessions
      ;;
    -k|--kill|kill)
      shift
      [[ $# -eq 1 ]] || die "kill: expected exactly one alias"
      require_tmux
      load_config
      kill_session "$1"
      ;;
    --kill-all|kill-all)
      [[ $# -eq 1 ]] || die "kill-all: takes no arguments"
      require_tmux
      load_config
      kill_all_sessions
      ;;
    -*)
      die "unknown option: $1 (try 'tx help')"
      ;;
    *)
      [[ $# -eq 1 ]] || die "expected exactly one alias, got: $*"
      require_tmux
      [[ -f "$CONFIG_PATH" ]] && load_config
      # tx pi-autowork-<name> opens that runner's session unless an alias has the name.
      if [[ "$1" == "$AUTOWORK_PREFIX"?* && -z "${ALIAS_TO_PATH[$1]+x}" ]]; then
        autowork_start "${1#"$AUTOWORK_PREFIX"}"
        return 0
      fi
      load_config
      attach_session "$1"
      ;;
  esac
}

main "$@"
